        96% { transform: translate(6px, -2px) skew(-3deg); opacity: 0.9; filter: drop-shadow(-3px 0 0 #FF4242) drop-shadow(3px 0 0 #61D5BA); }
        98% { transform: translate(-2px, 4px) skew(1deg); opacity: 1; filter: none; }
